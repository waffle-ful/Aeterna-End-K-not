# Normalize line endings for text files
# upstream EHR uses CRLF; fork standardizes on LF for cleaner cherry-picks
.gitattributes text eol=lf
.gitignore     text eol=lf

*.cs        text eol=lf
*.csproj    text eol=lf
*.props     text eol=lf
*.targets   text eol=lf
*.json      text eol=lf
*.jsonc     text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.xml       text eol=lf
*.sh        text eol=lf
*.txt       text eol=lf

*.sln       text eol=crlf

# Binary assets — never touch line endings
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.dll       binary
*.exe       binary
*.zip       binary
*.ogg       binary
*.mp3       binary
*.wav       binary
*.ttf       binary
*.otf       binary

# --------------------------------------------------
# Language Stats (GitHub Linguist Settings)
# --------------------------------------------------
# 1. スクリプト類（PowerShell, Python, Shell, Batch）
*.ps1       linguist-detectable=false
*.psm1      linguist-detectable=false
*.psd1      linguist-detectable=false
*.py        linguist-detectable=false
*.sh        linguist-detectable=false
*.bat       linguist-detectable=false
*.cmd       linguist-detectable=false

# 2. Web・スタイル類（CSS, HTML, JS）
*.css       linguist-detectable=false
*.scss      linguist-detectable=false
*.html      linguist-detectable=false
*.htm       linguist-detectable=false
*.js        linguist-detectable=false
*.jsx       linguist-detectable=false
*.mjs       linguist-detectable=false
*.cjs       linguist-detectable=false

# 4.
*.json      linguist-vendored
*.jsonc     linguist-vendored
*.xml       linguist-vendored
*.yml       linguist-vendored
*.yaml      linguist-vendored
*.props     linguist-vendored
*.targets   linguist-vendored