<Window x:Class="EndKnotInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="End K not インストーラー" Height="520" Width="680"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"
                   Text="End K not インストーラー"/>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Among Us: " Margin="0,0,6,0"/>
            <ComboBox x:Name="InstallCombo" Grid.Column="1" VerticalAlignment="Center"
                      SelectionChanged="InstallCombo_SelectionChanged"/>
            <Button Grid.Column="2" Content="再検索" Margin="6,0,0,0" Padding="10,3" Click="ClickRescan"/>
            <Button Grid.Column="3" Content="手動選択…" Margin="6,0,0,0" Padding="10,3" Click="ClickBrowse"/>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,0,0,10" FontSize="13"
                   Text="Among Us を検索中…"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="InstallButton" Content="インストール / 更新" Padding="14,6" FontWeight="Bold" Click="ClickInstall"/>
            <Button x:Name="ToggleButton" Content="モッド無効化⇔有効化" Padding="14,6" Margin="8,0,0,0" Click="ClickToggle"/>
            <Button x:Name="UninstallButton" Content="アンインストール" Padding="14,6" Margin="8,0,0,0" Click="ClickUninstall"/>
            <Button x:Name="LaunchButton" Content="ゲーム起動" Padding="14,6" Margin="8,0,0,0" Click="ClickLaunch"/>
        </StackPanel>

        <ProgressBar x:Name="Progress" Grid.Row="4" Height="16" Margin="0,0,0,8" Minimum="0" Maximum="1"/>

        <TextBox x:Name="LogBox" Grid.Row="5" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
    </Grid>
</Window>
