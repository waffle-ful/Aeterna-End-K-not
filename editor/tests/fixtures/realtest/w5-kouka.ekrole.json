{
  "ekr": 1,
  "requires": [],
  "name": "こうかや",
  "author": "EKN Realtest",
  "description": "じぶんに じゅんばんに こうかを かける けんしょう用の役職",
  "descriptionLong": "ベントに入るたびに モードが1つ すすみます。\n1=はやくする / 2=おそくする / 3=こおらせる / 4=くらくする の じゅんに じぶんへ こうかを かけます。\nあとから かけた こうかが 勝ち、じかんが 終わると もとの はやさに もどります。",
  "color": "#c8792f",
  "team": "crewmate",
  "canKill": false,
  "canVent": true,
  "visionMultiplier": 1.0,
  "winCondition": "team",
  "progress": { "text": "h{は}s{お}f{こ}b{く}" },
  "logic": {
    "version": 1,
    "variables": [
      { "name": "モ", "init": 0 },
      { "name": "は", "init": 0 },
      { "name": "お", "init": 0 },
      { "name": "こ", "init": 0 },
      { "name": "く", "init": 0 }
    ],
    "rules": [
      {
        "when": "on_game_start",
        "do": [
          { "op": "notify", "text": "こうかや かいし", "seconds": 3 }
        ]
      },
      {
        "when": "on_vent_enter",
        "do": [
          { "op": "var_add", "name": "モ", "delta": { "e": "lit", "v": 1 } },
          { "op": "notify", "text": "モードを すすめた", "seconds": 2 }
        ]
      },
      {
        "when": "on_var",
        "var": "モ",
        "cmp": "eq",
        "value": 1,
        "do": [
          { "op": "effect_give", "target": "self", "kind": "haste", "seconds": 20 },
          { "op": "var_add", "name": "は", "delta": { "e": "lit", "v": 1 } },
          { "op": "notify", "text": "はやくなった (20びょう)", "seconds": 3 }
        ]
      },
      {
        "when": "on_var",
        "var": "モ",
        "cmp": "eq",
        "value": 2,
        "do": [
          { "op": "effect_give", "target": "self", "kind": "slow", "seconds": 20 },
          { "op": "var_add", "name": "お", "delta": { "e": "lit", "v": 1 } },
          { "op": "notify", "text": "おそくなった (20びょう)", "seconds": 3 }
        ]
      },
      {
        "when": "on_var",
        "var": "モ",
        "cmp": "eq",
        "value": 3,
        "do": [
          { "op": "effect_give", "target": "self", "kind": "freeze", "seconds": 8 },
          { "op": "var_add", "name": "こ", "delta": { "e": "lit", "v": 1 } },
          { "op": "notify", "text": "こおった (8びょう)", "seconds": 3 }
        ]
      },
      {
        "when": "on_var",
        "var": "モ",
        "cmp": "eq",
        "value": 4,
        "do": [
          { "op": "effect_give", "target": "self", "kind": "blind", "seconds": 25 },
          { "op": "var_add", "name": "く", "delta": { "e": "lit", "v": 1 } },
          { "op": "notify", "text": "くらくなった (25びょう)", "seconds": 3 }
        ]
      },
      {
        "when": "on_vent_exit",
        "do": [
          { "op": "notify", "text": "いま モード{モ}", "seconds": 3 }
        ]
      },
      {
        "when": "on_meeting_start",
        "do": [
          { "op": "notify", "text": "かいぎ モード{モ}", "seconds": 3 }
        ]
      }
    ]
  }
}
