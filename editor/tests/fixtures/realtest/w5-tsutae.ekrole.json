{
  "ekr": 1,
  "requires": [],
  "name": "つたえや",
  "author": "EKN Realtest",
  "description": "そばの人に こうかを かける けんしょう用の役職",
  "descriptionLong": "ベントに入るたびに モードが1つ すすみます。\n1=そばを はやく / 2=そばを くらく / 3=じぶんを はやく / 4=そばを こおらせる。\nしんだときは そばの人を こおらせます。",
  "color": "#7a5fd0",
  "team": "crewmate",
  "canKill": false,
  "canVent": true,
  "visionMultiplier": 1.0,
  "winCondition": "team",
  "passives": { "speedMult": 1.3 },
  "progress": { "text": "h{は}b{く}d{し}" },
  "logic": {
    "version": 1,
    "variables": [
      { "name": "モ", "init": 0 },
      { "name": "は", "init": 0 },
      { "name": "く", "init": 0 },
      { "name": "し", "init": 0 }
    ],
    "rules": [
      {
        "when": "on_game_start",
        "do": [
          { "op": "notify", "text": "つたえや かいし", "seconds": 3 }
        ]
      },
      {
        "when": "on_vent_enter",
        "do": [
          { "op": "var_add", "name": "モ", "delta": { "e": "lit", "v": 1 } },
          { "op": "notify", "text": "モードを すすめた", "seconds": 2 }
        ]
      },
      {
        "when": "on_var",
        "var": "モ",
        "cmp": "eq",
        "value": 1,
        "do": [
          { "op": "effect_give", "target": "nearest", "kind": "haste", "seconds": 20 },
          { "op": "var_add", "name": "は", "delta": { "e": "lit", "v": 1 } },
          { "op": "notify", "text": "そばを はやく (20)", "seconds": 3 }
        ]
      },
      {
        "when": "on_var",
        "var": "モ",
        "cmp": "eq",
        "value": 2,
        "do": [
          { "op": "effect_give", "target": "nearest", "kind": "blind", "seconds": 25 },
          { "op": "var_add", "name": "く", "delta": { "e": "lit", "v": 1 } },
          { "op": "notify", "text": "そばを くらく (25)", "seconds": 3 }
        ]
      },
      {
        "when": "on_var",
        "var": "モ",
        "cmp": "eq",
        "value": 3,
        "do": [
          { "op": "effect_give", "target": "self", "kind": "haste", "seconds": 20 },
          { "op": "notify", "text": "じぶんを はやく (20)", "seconds": 3 }
        ]
      },
      {
        "when": "on_var",
        "var": "モ",
        "cmp": "eq",
        "value": 4,
        "do": [
          { "op": "effect_give", "target": "nearest", "kind": "freeze", "seconds": 10 },
          { "op": "notify", "text": "そばを こおり (10)", "seconds": 3 }
        ]
      },
      {
        "when": "on_death",
        "do": [
          { "op": "effect_give", "target": "nearest", "kind": "freeze", "seconds": 10 },
          { "op": "var_add", "name": "し", "delta": { "e": "lit", "v": 1 } },
          { "op": "notify", "text": "みちづれ こおり", "seconds": 3 }
        ]
      }
    ]
  }
}
