{
  "ekr": 1,
  "requires": [],
  "name": "灯台守",
  "author": "EKN Sample",
  "color": "#f5c542",
  "team": "crewmate",
  "canKill": false,
  "killCooldown": 25,
  "canVent": false,
  "visionMultiplier": 1,
  "winCondition": "team",
  "logic": {
    "version": 1,
    "variables": [
      { "name": "共有した回数", "init": 0 }
    ],
    "rules": [
      {
        "when": "on_game_start",
        "do": [
          { "op": "cno_spawn", "slot": 1, "text": "灯", "size": 6, "at": "self" },
          { "op": "wait", "seconds": 1.1 },
          { "op": "cno_spawn", "slot": 2, "text": "火", "size": 12, "at": "self" },
          { "op": "wait", "seconds": 1.1 },
          { "op": "cno_spawn", "slot": 3, "text": "<灯>", "size": 1, "at": "self" }
        ]
      },
      {
        "when": "on_pet",
        "do": [
          { "op": "var_add", "name": "共有した回数", "delta": { "e": "lit", "v": 1 } },
          { "op": "cno_move", "slot": 1, "dx": 3, "dy": 0 },
          { "op": "cno_move", "slot": 2, "dx": -3, "dy": 0 },
          { "op": "cno_move", "slot": 3, "dx": 0, "dy": 3 }
        ]
      },
      {
        "when": "on_meeting_end",
        "do": [
          { "op": "cno_show", "slot": 3, "who": "all" },
          { "op": "notify", "text": "灯りを分かち合おう", "seconds": 2 }
        ]
      },
      {
        "when": "on_task_complete",
        "do": [
          { "op": "cno_despawn", "slot": 3 },
          { "op": "cno_spawn", "slot": 3, "text": "新", "size": 8, "at": "self" }
        ]
      },
      {
        "when": "on_death",
        "do": [
          { "op": "cno_despawn", "slot": 1 },
          { "op": "cno_despawn", "slot": 2 },
          { "op": "cno_despawn", "slot": 3 },
          { "op": "notify", "text": "灯りが消えた…", "seconds": 3 }
        ]
      }
    ]
  }
}
