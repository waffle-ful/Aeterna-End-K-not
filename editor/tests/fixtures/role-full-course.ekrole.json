{
  "ekr": 1,
  "requires": [],
  "name": "彷徨う影",
  "author": "EKN Sample",
  "description": "影を渡り歩き、触れた者の運命を書き換える",
  "descriptionLong": "影を渡り歩く役職です。\nペットを押すと目印を残し、その場所へあとから跳べます。\n攻撃されたときは影が身代わりになりますが、回数には限りがあります。",
  "color": "#5b3a99",
  "team": "crewmate",
  "canKill": true,
  "killCooldown": 25,
  "canVent": true,
  "visionMultiplier": 1.2,
  "winCondition": "team",
  "passives": {
    "speedMult": 1.2,
    "shield": { "count": 2 },
    "corpse": "noReport",
    "voteWeight": 2,
    "doom": { "seconds": 300 },
    "killDistance": "short",
    "disguise": { "team": "neutral" }
  },
  "logic": {
    "version": 1,
    "variables": [
      { "name": "うらみ", "init": 0 },
      { "name": "タスク数", "init": 0 }
    ],
    "rules": [
      {
        "when": "on_game_start",
        "do": [
          { "op": "var_set", "name": "うらみ", "value": { "e": "lit", "v": 0 } },
          { "op": "notify", "text": "夜が来た…", "seconds": 3 },
          { "op": "vote_weight_set", "value": 2 }
        ]
      },
      {
        "when": "on_pet",
        "do": [
          { "op": "var_add", "name": "うらみ", "delta": { "e": "lit", "v": 1 } },
          {
            "op": "if",
            "cond": { "e": "op", "kind": "ge", "a": { "e": "var", "name": "うらみ" }, "b": { "e": "lit", "v": 10 } },
            "then": [
              { "op": "notify", "text": "すべてを、晴らした…", "seconds": 3 },
              { "op": "kill", "target": "self" }
            ],
            "else": [
              {
                "op": "if",
                "cond": {
                  "e": "op",
                  "kind": "and",
                  "a": { "e": "op", "kind": "ge", "a": { "e": "var", "name": "うらみ" }, "b": { "e": "lit", "v": 3 } },
                  "b": {
                    "e": "op",
                    "kind": "not",
                    "a": { "e": "op", "kind": "eq", "a": { "e": "var", "name": "うらみ" }, "b": { "e": "lit", "v": 5 } }
                  }
                },
                "then": [
                  { "op": "cno_spawn", "slot": 1, "text": "影", "size": 8, "at": "self" },
                  { "op": "notify", "text": "影が濃くなる…", "seconds": 3 }
                ],
                "else": [
                  { "op": "notify", "text": "まだ闇は薄い", "seconds": 2 }
                ]
              }
            ]
          }
        ]
      },
      {
        "when": "on_kill",
        "do": [
          { "op": "set_kill_cooldown", "seconds": 20 },
          { "op": "speed", "mult": 1.5, "seconds": 5 },
          { "op": "notify", "text": "また一人、闇へ", "seconds": 3 },
          { "op": "reveal", "target": "ctx" }
        ]
      },
      {
        "when": "on_death",
        "cause": "poison-curse",
        "do": [
          { "op": "cno_spawn", "slot": 2, "text": "消滅", "size": 10, "at": "self" },
          { "op": "cno_move", "slot": 2, "dx": 0, "dy": 3 },
          { "op": "notify", "text": "闇に還る…", "seconds": 3 }
        ]
      },
      {
        "when": "on_meeting_start",
        "do": [
          { "op": "notify", "text": "影はひそむ", "seconds": 2 },
          { "op": "arrow_hide" },
          { "op": "vote_block", "target": "nearest" }
        ]
      },
      {
        "when": "on_meeting_vote",
        "do": [
          { "op": "remember", "slot": 1, "target": "ctx" },
          {
            "op": "if",
            "cond": { "e": "op", "kind": "ge", "a": { "e": "var", "name": "うらみ" }, "b": { "e": "lit", "v": 10 } },
            "then": [
              { "op": "exile", "target": "ctx" }
            ],
            "else": [
              { "op": "cancel_vote" },
              { "op": "notify", "text": "また、見送った…", "seconds": 3 }
            ]
          }
        ]
      },
      {
        "when": "on_meeting_pick",
        "do": [
          { "op": "remember", "slot": 2, "target": "ctx" },
          { "op": "vote_swap" },
          { "op": "notify", "text": "票よ、いれかわれ…", "seconds": 3, "target": "ctx" }
        ]
      },
      {
        "when": "on_meeting_end",
        "do": [
          {
            "op": "var_set",
            "name": "うらみ",
            "value": {
              "e": "op",
              "kind": "sub",
              "a": { "e": "var", "name": "うらみ" },
              "b": { "e": "op", "kind": "div", "a": { "e": "var", "name": "うらみ" }, "b": { "e": "lit", "v": 2 } }
            }
          },
          { "op": "notify", "text": "また夜が続く", "seconds": 2 }
        ]
      },
      {
        "when": "on_task_complete",
        "do": [
          { "op": "var_add", "name": "タスク数", "delta": { "e": "lit", "v": 1 } },
          { "op": "arrow_show", "target": "nearest", "seconds": 30 }
        ]
      },
      {
        "when": "on_vent_enter",
        "do": [
          {
            "op": "if",
            "cond": {
              "e": "op",
              "kind": "or",
              "a": { "e": "op", "kind": "lt", "a": { "e": "var", "name": "うらみ" }, "b": { "e": "lit", "v": 10 } },
              "b": { "e": "op", "kind": "eq", "a": { "e": "var", "name": "タスク数" }, "b": { "e": "lit", "v": 0 } }
            },
            "then": [
              { "op": "cno_move", "slot": 1, "dx": 2, "dy": -2 },
              { "op": "speed", "mult": 2.0, "seconds": 3 },
              { "op": "inspect", "target": "nearest", "depth": "role", "failChance": 10, "noise": 2 }
            ]
          }
        ]
      },
      {
        "when": "on_report",
        "do": [
          { "op": "cno_show", "slot": 1, "who": "all" },
          { "op": "notify", "text": "見つけたのか…", "seconds": 3 },
          { "op": "teleport", "to": "random" },
          { "op": "arrow_mark", "at": "ctx", "seconds": 60 }
        ]
      },
      {
        "when": "on_cno_touch",
        "slot": 1,
        "do": [
          { "op": "marker_save", "slot": 1, "at": "ctx" },
          { "op": "notify", "text": "触れた…", "seconds": 2 },
          { "op": "teleport_other", "target": "ctx", "to": "marker1" }
        ]
      },
      {
        "when": "on_attacked",
        "kind": "force",
        "do": [
          { "op": "cancel_attack" },
          { "op": "remember", "slot": 1, "target": "ctx" },
          { "op": "notify", "text": "その手は影を切っただけ…", "seconds": 3, "target": "ctx" }
        ]
      },
      {
        "when": "on_second",
        "do": [
          {
            "op": "if",
            "cond": { "e": "op", "kind": "gt", "a": { "e": "var", "name": "うらみ" }, "b": { "e": "lit", "v": 5 } },
            "then": [
              { "op": "cno_despawn", "slot": 2 },
              { "op": "stop" }
            ],
            "else": [
              { "op": "wait", "seconds": 0.1 }
            ]
          }
        ]
      }
    ]
  }
}
