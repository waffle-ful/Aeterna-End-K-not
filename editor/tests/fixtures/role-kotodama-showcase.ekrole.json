{
  "ekr": 1,
  "requires": [],
  "name": "ことだまや",
  "author": "EKN Sample",
  "description": "会議中に「うそ」と言った人は、会議明けにキルされる",
  "color": "#e0637a",
  "team": "crewmate",
  "canKill": false,
  "killCooldown": 25,
  "canVent": false,
  "visionMultiplier": 1,
  "winCondition": "team",
  "logic": {
    "version": 1,
    "variables": [],
    "rules": [
      {
        "when": "on_chat",
        "match": "うそ",
        "do": [
          { "op": "remember", "slot": 1, "target": "ctx" },
          { "op": "notify", "text": "ことだまが うずく…", "seconds": 2, "target": "ctx" }
        ]
      },
      {
        "when": "on_meeting_end",
        "do": [
          { "op": "kill", "target": "saved1" }
        ]
      }
    ]
  }
}
