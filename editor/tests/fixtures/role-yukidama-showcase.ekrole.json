{
  "ekr": 1,
  "requires": [],
  "name": "ゆきだま",
  "author": "EKN Sample",
  "description": "ゆきだまを投げて当てるとキルできる",
  "color": "#7fd1ff",
  "team": "crewmate",
  "canKill": false,
  "killCooldown": 25,
  "canVent": false,
  "visionMultiplier": 1,
  "winCondition": "team",
  "logic": {
    "version": 1,
    "variables": [],
    "rules": [
      {
        "when": "on_pet",
        "do": [
          { "op": "cno_spawn", "slot": 1, "text": "❄", "size": 6, "at": "self" },
          { "op": "cno_launch", "slot": 1, "dir": "move" }
        ]
      },
      {
        "when": "on_cno_touch",
        "slot": 1,
        "do": [
          { "op": "kill", "target": "ctx" },
          { "op": "cno_despawn", "slot": 1 }
        ]
      }
    ]
  }
}
