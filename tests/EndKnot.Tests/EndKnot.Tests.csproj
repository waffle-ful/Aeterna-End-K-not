<Project Sdk="Microsoft.NET.Sdk">

    <!-- 純ロジック向けユニットテスト (ソース共有方式)。
         本体 EndKnot.csproj は IL2CPP/BepInEx 参照だらけなので ProjectReference は不可 —
         Unity 依存ゼロの .cs だけを Compile Include で直接コンパイルする。
         ゲーム/BepInEx 型への参照 (Logger / HashRandom) は Support/GameShims.cs のスタブで解決。 -->
    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <!-- .NET 6 ランタイムが無いマシン (8/10 のみ等) でもテストホストを起動できるようにする -->
        <RollForward>LatestMajor</RollForward>
        <LangVersion>preview</LangVersion>
        <Nullable>disable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
        <PackageReference Include="xunit" Version="2.9.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!-- 本体からソース共有するテスト対象 (Unity/Il2Cpp/BepInEx import ゼロのファイルのみ)。
         HashRandomWrapper.cs はゲーム側 HashRandom を呼ぶため、テストではシムに委譲される
         (コンパイル成立のために含める。挙動テストの対象外)。 -->
    <ItemGroup>
        <Compile Include="..\..\Modules\EkmCodec.cs" Link="src\EkmCodec.cs" />
        <!-- EKR 役職コードの契約。EkrDefinition / EkrPassives は Unity 非依存。
             EkmLogicRuntime だけが UnityEngine.Time を触るので Support/GameShims.cs のスタブで解決する。 -->
        <Compile Include="..\..\Modules\Ekm\EkrDefinition.cs" Link="src\Ekm\EkrDefinition.cs" />
        <Compile Include="..\..\Modules\Ekm\EkrPassives.cs" Link="src\Ekm\EkrPassives.cs" />
        <Compile Include="..\..\Modules\Ekm\EkmLogicRuntime.cs" Link="src\Ekm\EkmLogicRuntime.cs" />
        <Compile Include="..\..\Modules\Random\IRandom.cs" Link="src\Random\IRandom.cs" />
        <Compile Include="..\..\Modules\Random\MersenneTwister.cs" Link="src\Random\MersenneTwister.cs" />
        <Compile Include="..\..\Modules\Random\Xorshift.cs" Link="src\Random\Xorshift.cs" />
        <Compile Include="..\..\Modules\Random\NetRandomWrapper.cs" Link="src\Random\NetRandomWrapper.cs" />
        <Compile Include="..\..\Modules\Random\HashRandomWrapper.cs" Link="src\Random\HashRandomWrapper.cs" />
    </ItemGroup>

    <!-- TS 側 (editor/) の役職 fixture をそのまま読んで C# 検証にかける。TS↔C# の契約非対称を
         機械検出する網なので、fixture 自体は編集しない (TS 側資材が正典)。 -->
    <ItemGroup>
        <None Include="..\..\editor\tests\fixtures\*.ekrole.json" Link="fixtures\%(Filename)%(Extension)">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!-- 埋込出荷役職 (Resources/EkRoles/*.ekrole.json — LoadEmbeddedRoles が起動時に束縛する定義) を
         全数パース検証にかける。壊れた定義を同梱すると実機では起動ログの warn 1行で無音に消えるため、
         テストで先に落とす。 -->
    <ItemGroup>
        <None Include="..\..\Resources\EkRoles\*.ekrole.json" Link="embedded-roles\%(Filename)%(Extension)">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
